# ------------------------------------------------------------------
# Repository layout
#
#   legacy/    original RAN implementation (reference only)
#   modern/    new authoritative RAN implementation
#   reference/ research notes and mappings
#   docs/      architecture documentation
# ------------------------------------------------------------------

# Local scratch: native item.isf round-trip fixtures (~72MB) and tool logs.
# Generated by reference/data-formats/NativeItemRoundTrip, never committed.
ItemTest/

# RanOnline Asura — build / IDE / temp outputs
_Build/
_Bin/
x64/
Debug/
Release/
Win32/
.ipch/
.vs/
*.sdf
*.opensdf
*.VC.db
*.VC.opendb
*.ncb
*.suo
*.user
*.userosscache
*.sln.docstates

# CMake
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
build/
# build-<config> output trees; rule added for VERTICAL-005, fixed for BUILD-001.
# It must be a bare pattern: git has no inline comments, so a trailing
# "<-- added for ..." on the same line becomes part of the pattern and
# matches nothing.
build-*/
out/
install_manifest.txt
CTestTestfile.cmake
_deps/

# vcpkg
vcpkg_installed/
.vcpkg-root

# Compiled objects / libs / exes
*.obj
*.pch
*.pdb
*.idb
*.tlog
*.lastbuildstate
*.unsuccessfulbuild
*.lib
*.exp
*.dll
*.exe
*.ilk
*.meta

# Original source archive — keep tracked, do not ignore
!RanOnline*.zip

# OS
Thumbs.db
Desktop.ini
.DS_Store
